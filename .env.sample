# Copy to .env to override defaults. Compose and the apps work without it.
# Never commit .env (see .gitignore).

POSTGRES_DB=levelpath
# The image creates this user as the database OWNER/superuser. Migrations run as it.
# From Phase 2 the app connects as a separate NON-owner role so RLS applies to it.
POSTGRES_USER=levelpath_owner
POSTGRES_PASSWORD=levelpath_dev_password
POSTGRES_PORT=5432

API_PORT=3000

# ---- Harness (ADWs, L3). All optional. ----
# The agents use your logged-in Claude subscription. ANTHROPIC_API_KEY is not
# passed to them unless ADW_USE_API_KEY=true. Leave both unset.
# ADW_USE_API_KEY=false
# A GitHub token for screenshot uploads to <you>/adw-screenshots; without it,
# runs use your `gh auth login` and list screenshots by local path.
# GITHUB_PAT=
# Chrome for agent-browser when its own download is blocked (Avast):
# AGENT_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Seconds between the opt-in trigger's polls (minimum 60):
# ADW_POLL_SECONDS=60
