# Copy to .env to override defaults. Compose and the apps work without it.
# Compose reads .env; the API and the db scripts don't: they read the process
# environment, with these values as defaults. If you change one here, export it
# in your shell too.
# Never commit .env (see .gitignore).

POSTGRES_DB=levelpath
# The image creates this user as the database OWNER/superuser. Migrations run as it.
# The API never does: it connects as the NON-owner app role below, so RLS applies to it.
POSTGRES_USER=levelpath_owner
POSTGRES_PASSWORD=levelpath_dev_password
POSTGRES_PORT=5432
# Where the API and the db scripts find Postgres (Compose publishes it on localhost).
POSTGRES_HOST=localhost
# The API's own login: it owns nothing and is not a superuser, so RLS always
# applies to it. `pnpm db:migrate` creates it when it is missing. Dev values only.
APP_DB_USER=levelpath_app
APP_DB_PASSWORD=levelpath_app_dev_password

API_PORT=3000

# ---- Harness (ADWs, L3). All optional. ----
# The agents use your logged-in Claude subscription. ANTHROPIC_API_KEY is not
# passed to them unless ADW_USE_API_KEY=true. Leave both unset.
# ADW_USE_API_KEY=false
# Optional GitHub token for the ADWs' `gh` calls; without it they use your
# `gh auth login`. Screenshots in PR comments need neither: factory/bin/shots
# uploads them to <you>/adw-screenshots through `gh`, for public repos only.
# GITHUB_PAT=
# Chrome for agent-browser when its own download is blocked (Avast):
# AGENT_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Seconds between the opt-in trigger's polls (minimum 60):
# ADW_POLL_SECONDS=60
