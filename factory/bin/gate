#!/usr/bin/env -S python3 -X utf8
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>                     factory job: write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate --run <worktree> <round-dir> any driver (ADWs, /verify): the same, for a worktree and a round folder
  gate --tree <worktree>            print the id the gate records as COMMIT for this worktree
  gate --hook                       builder Stop hook: run the checks once, exit 2 on failure

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`). Adding new files is fine.

COMMIT is the HEAD commit, plus `+dirty:<hash>` when the worktree has
uncommitted changes (L1 pairs in the main checkout without committing), so a
round's record names the exact code it judged.

Before running the checks, the gate checks the services in config.json
`gate_services` (a TCP address each). When one is down it exits 2 without
writing a round: a stopped database is not a failed build.

A second run in the same round folder keeps the earlier record as
checks-<k>.md and checks-<k>.log.
"""

import fnmatch
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
TAIL = 80


def find_bash():
    """bash to run checks.sh with. On Windows that must be Git Bash: a bare
    "bash" can resolve to C:\\Windows\\System32\\bash.exe, which is WSL."""
    if os.name != "nt":
        return "bash"
    exec_path = subprocess.run(["git", "--exec-path"], capture_output=True, text=True).stdout.strip()
    if exec_path:  # <git>/mingw64/libexec/git-core → <git>/bin/bash.exe
        candidate = Path(exec_path).parents[2] / "bin" / "bash.exe"
        if candidate.exists():
            return str(candidate)
    found = shutil.which("bash")
    if found and "system32" not in found.lower():
        return found
    die("Git Bash not found: install Git for Windows (https://git-scm.com/download/win)")


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Existing files under protected_paths that the branch modified or deleted.

    None when there is no origin/<base> to compare with (a repo not pushed yet):
    the summary then says the check was skipped."""
    base = f"origin/{CONFIG['base_branch']}"
    known = subprocess.run(["git", "rev-parse", "--verify", "--quiet", base], cwd=worktree,
                           capture_output=True, text=True)
    if known.returncode != 0:
        return None
    diff = git(worktree, "diff", "--name-status", f"{base}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in CONFIG["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def tree_id(worktree):
    """HEAD, plus a hash of the uncommitted changes (tracked diffs and untracked
    files that aren't ignored) when there are any."""
    commit = git(worktree, "rev-parse", "HEAD").strip()
    if not git(worktree, "status", "--porcelain").strip():
        return commit
    digest = hashlib.sha256(
        subprocess.run(["git", "diff", "HEAD", "--binary"], cwd=worktree, capture_output=True).stdout)
    for rel in sorted(git(worktree, "ls-files", "--others", "--exclude-standard").splitlines()):
        digest.update(rel.encode())
        try:
            digest.update((Path(worktree) / rel).read_bytes())
        except OSError as e:
            die(f"can't read {rel} to identify the worktree's changes: {e}")
    return f"{commit}+dirty:{digest.hexdigest()[:12]}"


def services_down():
    """The config.json `gate_services` that don't answer: [(address, hint)]."""
    down = []
    for service in CONFIG.get("gate_services", []):
        host, _, port = service["tcp"].rpartition(":")
        try:
            socket.create_connection((host, int(port)), timeout=3).close()
        except OSError:
            down.append((service["tcp"], service.get("hint", "")))
    return down


def keep_earlier_run(round_dir):
    """Rename an earlier checks.md/.log in this round to checks-<k>.*, so a re-run
    never hides that the first run failed. Returns the kept file names."""
    if not (round_dir / "checks.md").exists():
        return []
    k = 1
    while (round_dir / f"checks-{k}.md").exists():
        k += 1
    (round_dir / "checks.md").replace(round_dir / f"checks-{k}.md")
    if (round_dir / "checks.log").exists():
        (round_dir / "checks.log").replace(round_dir / f"checks-{k}.log")
    return sorted(p.name for p in round_dir.glob("checks-*.md"))


def run_checks(worktree):
    start = time.monotonic()
    res = subprocess.run([find_bash(), CHECKS.as_posix()], cwd=worktree, capture_output=True, text=True)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    run_gate(job["worktree"], FACTORY / "jobs" / job_id / f"round-{job['round']}",
             f"{job_id} round {job['round']}")


def run_gate(worktree, round_dir, label):
    down = services_down()
    if down:
        die("not run, a service the checks need is down: "
            + "; ".join(f"{addr} ({hint})" if hint else addr for addr, hint in down)
            + ". Start it, then run the gate again. No round was recorded.")
    round_dir = Path(round_dir)
    round_dir.mkdir(parents=True, exist_ok=True)
    commit = tree_id(worktree)
    earlier = keep_earlier_run(round_dir)
    protected = protected_changes(worktree)
    skipped = protected is None
    protected = protected or []
    code, log, seconds = run_checks(worktree)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    (round_dir / "checks.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        "Protected paths: " + ("not checked (no origin/" + CONFIG["base_branch"] + " yet)" if skipped
                               else "changed: " + ", ".join(protected) if protected else "none changed"),
        f"Commit {commit[:7]}" + (" with uncommitted changes" if "+dirty:" in commit else ""),
    ]
    if earlier:
        summary.append("Earlier runs in this round: " + ", ".join(
            f"{name} ({(round_dir / name).read_text().splitlines()[0]})" for name in earlier))
    (round_dir / "checks.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of checks.log:\n\n```\n{tail}\n```\n"
    )
    print(f"GATE: {verdict} ({label}, checks.sh exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def first_prompt(f):
    """The first user prompt in a transcript. A subagent's file (L2) starts with it; a
    headless `claude -p --agent` session's (L3) starts with setup entries (agent-setting,
    session-owner, queue-operation). Reading only line 1 found no job there, so the L3
    builder's checks were silently skipped."""
    for _ in range(30):
        line = f.readline()
        if not line:
            break
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        message = entry.get("message")
        if isinstance(message, dict) and entry.get("type", "user") == "user":
            content = message.get("content", "")
            return content if isinstance(content, str) else " ".join(
                b.get("text", "") for b in content if isinstance(b, dict))
    return ""


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    # A subagent's Stop event carries agent_transcript_path; a headless
    # `claude -p --agent builder` session (the ADWs) carries transcript_path.
    transcript = event.get("agent_transcript_path") or event.get("transcript_path")
    if not transcript:
        sys.exit(0)
    with open(Path(transcript).expanduser(), encoding="utf-8", errors="replace") as f:
        prompt = first_prompt(f)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0] if "Job: " in prompt else ""
    job_file = FACTORY / "jobs" / job_id / "job.json"
    if job_id and job_file.exists():
        worktree = json.loads(job_file.read_text())["worktree"]
    elif "Worktree: " in prompt:
        worktree = prompt.split("Worktree: ", 1)[1].split(". ", 1)[0].strip()
    else:
        sys.exit(0)  # not a run this hook can identify: let it stop
    code, log, _ = run_checks(worktree)
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0])
    elif len(argv) == 3 and argv[0] == "--run":
        run_gate(argv[1], argv[2], Path(argv[2]).name)
    elif len(argv) == 2 and argv[0] == "--tree":
        print(tree_id(argv[1]))
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
