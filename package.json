{
  "name": "levelpath-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic procurement demo: multi-tenant purchase requests built through a visible agent harness",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "dev": "pnpm db:up && pnpm -r --parallel dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
